{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "name": "rebuske",
  "cleanUrls": true,
  "trailingSlash": false,
  "framework": null,
  "rewrites": [
    {
      "source": "/api/primordiales-status",
      "destination": "/api/register-pro"
    },
    {
      "source": "/registro/tecnico",
      "destination": "/registro-tecnico.html"
    },
    {
      "source": "/registro/cliente",
      "destination": "/registro-cliente.html"
    },
    {
      "source": "/entrada",
      "destination": "/entrada.html"
    },
    {
      "source": "/entrada.html",
      "destination": "/entrada.html"
    },
    {
      "source": "/registro",
      "destination": "/registro.html"
    },
    {
      "source": "/unete",
      "destination": "/registro.html"
    },
    {
      "source": "/link",
      "destination": "/registro.html"
    },
    {
      "source": "/comunidad",
      "destination": "/registro.html"
    },
    {
      "source": "/registro.html",
      "destination": "/registro.html"
    },
    {
      "source": "/clientes",
      "destination": "/clientes-landing.html"
    },
    {
      "source": "/cliente",
      "destination": "/clientes-landing.html"
    },
    {
      "source": "/hogares",
      "destination": "/clientes-landing.html"
    },
    {
      "source": "/espera",
      "destination": "/clientes-landing.html"
    },
    {
      "source": "/clientes-landing.html",
      "destination": "/clientes-landing.html"
    },
    {
      "source": "/reembolsos",
      "destination": "/reembolsos.html"
    },
    {
      "source": "/tarifas",
      "destination": "/tarifas.html"
    },
    {
      "source": "/precios",
      "destination": "/tarifas.html"
    },
    {
      "source": "/tarifas.html",
      "destination": "/tarifas.html"
    },
    {
      "source": "/reembolsos.html",
      "destination": "/reembolsos.html"
    },
    {
      "source": "/descuentos",
      "destination": "/descuentos.html"
    },
    {
      "source": "/condiciones-descuentos",
      "destination": "/descuentos.html"
    },
    {
      "source": "/bono",
      "destination": "/descuentos.html"
    },
    {
      "source": "/descuentos.html",
      "destination": "/descuentos.html"
    },
    {
      "source": "/eliminar-cuenta",
      "destination": "/eliminar-cuenta.html"
    },
    {
      "source": "/baja",
      "destination": "/eliminar-cuenta.html"
    },
    {
      "source": "/api/cancel-account",
      "destination": "/api/cancel-account.js"
    },
    {
      "source": "/api/create-wompi-checkout",
      "destination": "/api/wompi?action=CREATE_CHECKOUT"
    },
    {
      "source": "/api/wompi-status",
      "destination": "/api/wompi?action=STATUS"
    },
    {
      "source": "/api/reconcile-pending",
      "destination": "/api/wompi?action=RECONCILE"
    },
    {
      "source": "/api/wompi-webhook",
      "destination": "/api/wompi?action=WEBHOOK"
    },
    {
      "source": "/terminos",
      "destination": "/terminos.html"
    },
    {
      "source": "/privacidad",
      "destination": "/privacidad.html"
    },
    {
      "source": "/chat",
      "destination": "/chat.html"
    },
    {
      "source": "/chat.html",
      "destination": "/chat.html"
    },
    {
      "source": "/sala",
      "destination": "/chat.html"
    },
    {
      "source": "/api/whatsapp-webhook",
      "destination": "/api/whatsapp-webhook.js"
    },
    {
      "source": "/webhook/whatsapp",
      "destination": "/api/whatsapp-webhook.js"
    },
    {
      "source": "/api/supabase/:path*",
      "destination": "https://vqvwcbirzezihfzaeziq.supabase.co/rest/v1/:path*"
    },
    {
      "source": "/pro",
      "destination": "/pro-landing.html"
    },
    {
      "source": "/pro.html",
      "destination": "/pro-landing.html"
    },
    {
      "source": "/registro-pro",
      "destination": "/pro-landing.html"
    },
    {
      "source": "/registro-pro.html",
      "destination": "/pro-landing.html"
    },
    {
      "source": "/primordial",
      "destination": "/pro-landing.html"
    },
    {
      "source": "/primordiales",
      "destination": "/pro-landing.html"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/.well-known/assetlinks.json",
      "destination": "/.well-known/assetlinks.json"
    },
    {
      "source": "/((?!api/|chat|chat\\\\.html|sala|terminos|terminos\\\\.html|privacidad|privacidad\\\\.html|reembolsos|reembolsos\\\\.html|tarifas|tarifas\\\\.html|precios|precios\\\\.html|eliminar-cuenta|eliminar-cuenta\\\\.html|baja|registro|registro\\\\.html|unete|link|comunidad|clientes|clientes\\\\.html|cliente|hogares|espera|clientes-landing|clientes-landing\\\\.html|pro|pro/|pro\\\\.html|pro-landing|pro-landing\\\\.html|registro-pro|registro-pro\\\\.html|primordiales|supabase-sync\\\\.js|assets/|robots\\\\.txt|sitemap\\\\.xml|\\.well-known/|.*\\\\.(?:js|css|png|jpg|jpeg|gif|svg|webp|ico|json|woff2?|pdf|txt|xml)).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self), camera=(), microphone=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/supabase-sync.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/.well-known/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/reconcile-pending",
      "schedule": "0 5 * * *"
    }
  ]
}
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "name": "rebuske-v4-prod",
  "cleanUrls": true,
  "trailingSlash": false,
  "framework": null,
  "rewrites": [
    {
      "source": "/api/supabase/:path*",
      "destination": "https://vqvwcbirzezihfzaeziq.supabase.co/rest/v1/:path*"
    },
    {
      "source": "/((?!supabase-sync\\.js|assets/|.*\\.(?:js|css|png|jpg|jpeg|gif|svg|webp|ico|json|woff2?)).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self), camera=(), microphone=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/supabase-sync.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
